{
  "name": "quillier",
  "productName": "Quillier",
  "version": "0.6.0",
  "description": "A quiet, local Markdown writing app for books.",
  "homepage": "https://quillier.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/poetapps/quillier.git"
  },
  "main": "electron/main.js",
  "license": "MIT",
  "author": "",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.quillier.app",
    "productName": "Quillier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/@node-llama-cpp/*-cuda/**",
      "!node_modules/@node-llama-cpp/*-cuda-ext/**",
      "!node_modules/@fugood/whisper.node/{src,whisper.cpp,scripts,CMakeLists.txt}",
      "!node_modules/@fugood/whisper.node/**/*.ts",
      "!node_modules/@fugood/node-whisper-wasm/**",
      "!node_modules/@fugood/*-cuda/**",
      "!node_modules/@fugood/*-vulkan/**",
      "!node_modules/@fugood/*-snapdragon/**"
    ],
    "fileAssociations": [
      {
        "ext": "quill",
        "name": "Quillier Project",
        "description": "Quillier Project",
        "role": "Editor",
        "mimeType": "application/x-quillier"
      },
      {
        "ext": "quillseries",
        "name": "Quillier Series",
        "description": "Quillier Series",
        "role": "Editor",
        "mimeType": "application/x-quillier-series"
      },
      {
        "ext": "ldraft",
        "name": "Quillier Project (older)",
        "description": "Quillier Project",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Quillier-mac-${arch}.${ext}",
      "electronLanguages": [
        "en",
        "en_GB"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Quillier listens only while you dictate, and what you say never leaves this computer."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Quillier-Setup.${ext}",
      "electronLanguages": [
        "en-US",
        "en-GB"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Quillier-linux.${ext}",
      "category": "Office",
      "electronLanguages": [
        "en-US",
        "en-GB"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "poetapps",
        "repo": "quillier"
      }
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**",
      "node_modules/node-llama-cpp/llama/localBuilds/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/@fugood/**",
      "electron/dictation/*.bin"
    ]
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bubble-menu": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.51.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fugood/whisper.node": "1.1.3",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "3.22.1"
  }
}
